// VisionCrafterAI Database Schema
// Last Updated: December 14, 2025

Table user {
  id integer [pk, increment]                          // Primary Key
  first_name varchar [not null]                       // User's first name
  last_name varchar [not null]                        // User's last name
  username varchar [unique, not null]                 // Unique username (indexed)
  email varchar [unique, not null]                    // Unique email address (indexed)
  hashed_password varchar [not null]                  // Bcrypt hashed password
  is_active boolean [default: true, not null]         // Account status flag
  created_at timestamp [default: `now()`, not null]   // Account creation timestamp (UTC)
  
  Note: 'Main user account table storing authentication and profile data'
}

Table refreshtoken {
  id integer [pk, increment]                          // Primary Key
  user_id integer [ref: > user.id, not null]          // Foreign Key to user table (indexed)
  token varchar [unique, not null]                    // The actual JWT refresh token (indexed)
  expires_at timestamp [not null]                     // Token expiration timestamp
  created_at timestamp [default: `now()`, not null]   // Token creation timestamp (UTC)
  is_revoked boolean [default: false, not null]       // Token revocation status (for logout)
  
  Note: 'Stores JWT refresh tokens for authentication and session management'
}

// Relationships
// One user can have multiple refresh tokens (1:N)
// RefreshToken.user_id -> User.id
